# DevGram Frontend Public Environment Variables
# ONLY public variables prefixed with VITE_ are exposed to the client bundle.
# NEVER put backend secrets, database credentials, or private keys here.

VITE_API_URL=http://localhost:5000

# Public Firebase Web Client Config (Public client API key, auth domain, project ID)
VITE_FIREBASE_API_KEY=mock-api-key
VITE_FIREBASE_AUTH_DOMAIN=devgram.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=devgram-project
VITE_FIREBASE_STORAGE_BUCKET=devgram.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
VITE_USE_MOCK_AUTH=true

# Analytics & Error Tracking (Public Client Keys)
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://app.posthog.com
VITE_PLAUSIBLE_DOMAIN=devgram.local
VITE_SENTRY_DSN=
