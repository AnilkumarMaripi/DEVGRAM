# DevGram Backend Environment Variables
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database Connections
# MongoDB (MongoDB Atlas or local fallback)
MONGODB_URI=mongodb://127.0.0.1:27017/DevGram

# PostgreSQL Connection
PGHOST=localhost
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres
PGPASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres

# Security & Session Authentication
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_characters

# Email Service (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password
EMAIL_FROM="DevGram <no-reply@devgram.local>"

# Sentry Error Tracking (Optional)
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# Firebase Admin (Mock or production service account)
FIREBASE_PROJECT_ID=devgram-project
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@devgram-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMOCK_KEY\n-----END PRIVATE KEY-----\n"
