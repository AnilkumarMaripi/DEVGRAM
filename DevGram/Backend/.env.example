PORT=5000
NODE_ENV=production
CLIENT_ORIGIN=https://devgram-sandy.vercel.app
CLIENT_URL=http://localhost:5173
MONGO_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/DevGram?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key

# Optional Firebase Admin Service Account placeholders
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"
